{
  "name": "mbab-sites",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:legacy-css": "tailwindcss -i ../searchapp/styles/tailwind.css -o ../searchapp/static/searchapp/stylesheets/styles.css --minify",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:unit": "node --test tests/search-state.test.mjs tests/reference-workflow.test.mjs tests/search-language.test.mjs tests/chapter-reader.test.mjs",
    "test:browser": "playwright test",
    "test:built": "node --test tests/built-app.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "overrides": {
    "postcss": "8.5.19"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/cli": "4.2.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.4",
    "wrangler": "4.111.0"
  },
  "type": "module"
}
